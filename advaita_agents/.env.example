# ── Multi-Provider Architecture ────────────────────────────────────────
# Each agent uses its own LLM configured in agents/*.py
# MODEL is the fallback default (used if an agent has no explicit llm=)
MODEL=gemini/gemini-2.5-pro

# ── Anthropic (Claude Sonnet 4.6) ──────────────────────────────────────
# Used by: Content Writer, Technical Reviewer (quality-critical agents)
# Get your key at: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Google Gemini 2.5 Pro ──────────────────────────────────────────────
# Used by: Topic Strategist, Research Agent, Quiz Designer (free tier)
# Get your key at: https://aistudio.google.com/apikey (no billing required)
GEMINI_API_KEY=your-gemini-api-key

# ── DeepSeek Chat ──────────────────────────────────────────────────────
# Used by: Coding Problem Designer (code generation at low cost)
# Get your key at: https://platform.deepseek.com/api_keys (requires prepaid credits)
DEEPSEEK_API_KEY=your-deepseek-api-key

# ── Serper.dev (Google Search API) ────────────────────────────────────
# Get your key at: https://serper.dev
# Required by: Topic Strategist (demand signal scraping)
# Required by: Research Agent (content research)
SERPER_API_KEY=your-serper-api-key

# ── Provider SDK Requirements ──────────────────────────────────────────
# Install with:
#   uv pip install anthropic google-genai litellm
# anthropic   → Claude native provider
# google-genai → Gemini native provider
# litellm      → DeepSeek (LiteLLM universal proxy)
